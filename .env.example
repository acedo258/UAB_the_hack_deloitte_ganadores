# Copia a .env y ajusta. Se lee con: set -a; source .env; set +a
SOC_DATA_DIR=./data/DTT-UAB-The-Hack     # el repo de Deloitte clonado aquí

# --- LLM (elige uno) ---
# Sin LLM (desarrollar la consola):
LLM_MODEL=mock
# Ollama local:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:8b
# LLM_API_KEY=ollama
# Groq (gratis, cada uno su cuenta):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=qwen/qwen3.8-27b          # o openai/gpt-oss-120b
# LLM_API_KEY=gsk_xxx

MOCK_API_URL=http://localhost:8000
PACK_MAX_CHARS=16000
